{
  "name": "laba5",
  "version": "1.0.0-SNAPSHOT",
  "description": "Лабораторная работа 5: автоматизация сборки",
  "main": "index.js",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "bin": "index.js",
  "scripts": {
    "start": "node index.js",
    "test": "jest",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pkg . --targets node18-win-x64 --output dist/laba5.exe"
  },
  "dependencies": {
    "winston": "^3.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "pkg": "^5.8.1"
  },
  "pkg": {
    "scripts": [
      "node_modules/winston/**/*.js"
    ],
    "assets": [
      "node_modules/winston/**/*.json"
    ]
  }
}
